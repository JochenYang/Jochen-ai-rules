{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_platform": "linux/macOS",
  "_note": "Linux/macOS version. For Windows, use hooks.windows.json instead. Copy the 'hooks' section into your ~/.claude/settings.json",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/prompt-linter.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/danger-guard.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/review-recommendation-guard.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/review-recommendation-guard.sh"
          }
        ]
      }
    ]
  }
}
