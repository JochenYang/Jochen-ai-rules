{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_platform": "windows",
  "_note": "Windows version. Copy the 'hooks' section into your %APPDATA%\\Claude\\claude_desktop_config.json or ~/.claude/settings.json",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -File hooks/prompt-linter.ps1"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -File hooks/danger-guard.ps1"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -File hooks/review-recommendation-guard.ps1"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -File hooks/review-recommendation-guard.ps1"
          }
        ]
      }
    ]
  }
}
